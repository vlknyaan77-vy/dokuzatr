//@version=6
indicator("Volcanic Auto Peaks & Valleys v6.6", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500)

// --- GRUPLAR / GROUPS ---
string GRP_AUTO = "⚓ Otomatik Çapa Ayarları / Auto Anchor Settings"
string GRP_FILT_P = "📏 Tepe Filtre Ayarları / Peak Filter Settings"
string GRP_FILT_V = "📏 Dip Filtre Ayarları / Valley Filter Settings"
string GRP_VIS  = "🎨 Görsel Ayarlar / Visual Settings"
string GRP_TAB  = "📊 Tablo Ayarları / Table Settings"

// --- GİRDİLER / INPUTS ---
lb_mode        = input.string("Manuel", "Tarama Modu / Lookback Mode", options=["Manuel", "Otomatik (Hassasiyet)", "Global (Maksimum)", "Zaman (Manuel Çapa)"], group=GRP_AUTO)
lb_sens        = input.int(5, "Otomatik Hassasiyet / Auto Sensitivity", minval=1, maxval=20, group=GRP_AUTO)
auto_lookback  = input.int(360, "Manuel Tarama Mesafesi / Manual Lookback", minval=10, maxval=4990, group=GRP_AUTO)
auto_threshold = input.float(0.1, "Sabitleme Eşiği / Settle Threshold (x sz)", group=GRP_AUTO, tooltip="Fiyat filtreden bu kadar uzaklaşırsa çapa güncellenir.")
auto_prox_threshold = input.float(0.5, "Yaklaşma Eşiği / Proximity Threshold (%)", group=GRP_AUTO, tooltip="Fiyat filtreye bu kadar yaklaşırsa çapa güncellenir.")
p_anchor_time  = input.time(timestamp("2024-01-01 00:00"), "Tepe Çapa Zamanı / Peak Anchor Time", confirm=true, group=GRP_AUTO)
v_anchor_time  = input.time(timestamp("2024-01-01 00:00"), "Dip Çapa Zamanı / Valley Anchor Time", confirm=true, group=GRP_AUTO)

use_auto_motor = input.bool(false, "🤖 Otomatik Optimizasyon Motorunu Aç (ATR)", group=GRP_AUTO, tooltip="Açık: Fiyatı kırmayan en uygun ATR periyodu otomatik olarak seçilir.")

// --- ATR PERİYODU GİRİŞLERİ ---
p_atr_opt = input.string(defval="9", title="Tepe ATR Periyodu (Peak)", group=GRP_FILT_P, options=["0.09", "0.18", "0.225", "0.27", "0.36", "0.45", "0.54", "0.63", "0.72", "0.81", "0.9", "1.0", "1.125", "1.35", "1.8", "2.0", "2.25", "2.7", "3.15", "3.6", "4.05", "4.5", "4.95", "5.4", "5.85", "6.3", "6.75", "7.2", "7.65", "8.1", "8.55", "9", "9.45", "9.9", "10.35", "10.8", "11.25", "11.7", "12.15", "12.6", "13.05", "13.5", "13.95", "14.4", "14.85", "15.3", "15.75", "16.2", "16.65", "17.1", "17.55", "18", "20.25", "20.7", "21.6", "22.05", "22.5", "22.95", "23.4", "23.85", "24.3", "24.75", "25.2", "25.65", "26.1", "26.55", "27", "27.45", "27.9", "28.35", "28.8", "29.25", "29.7", "30.15", "30.6", "31.05", "31.5", "31.95", "32.4", "32.85", "33.3", "33.75", "34.2", "34.65", "35.1", "35.55", "36", "39.6", "40.5", "43.2", "45", "46.8", "49.5", "50.4", "54", "57.6", "58.5", "61.2", "63", "64.8", "67.5", "68.4", "72", "76.5", "81", "85.5", "90", "94.5", "99", "103.5", "108", "112.5", "117", "121.5", "126", "130.5", "135", "139.5", "144", "148.5", "153", "157.5", "162", "166.5", "171", "175.5", "180", "270", "360", "450", "540", "630", "720", "810", "900"])
v_atr_opt = input.string(defval="9", title="Dip ATR Periyodu (Valley)", group=GRP_FILT_V, options=["0.09", "0.18", "0.225", "0.27", "0.36", "0.45", "0.54", "0.63", "0.72", "0.81", "0.9", "1.0", "1.125", "1.35", "1.8", "2.0", "2.25", "2.7", "3.15", "3.6", "4.05", "4.5", "4.95", "5.4", "5.85", "6.3", "6.75", "7.2", "7.65", "8.1", "8.55", "9", "9.45", "9.9", "10.35", "10.8", "11.25", "11.7", "12.15", "12.6", "13.05", "13.5", "13.95", "14.4", "14.85", "15.3", "15.75", "16.2", "16.65", "17.1", "17.55", "18", "20.25", "20.7", "21.6", "22.05", "22.5", "22.95", "23.4", "23.85", "24.3", "24.75", "25.2", "25.65", "26.1", "26.55", "27", "27.45", "27.9", "28.35", "28.8", "29.25", "29.7", "30.15", "30.6", "31.05", "31.5", "31.95", "32.4", "32.85", "33.3", "33.75", "34.2", "34.65", "35.1", "35.55", "36", "39.6", "40.5", "43.2", "45", "46.8", "49.5", "50.4", "54", "57.6", "58.5", "61.2", "63", "64.8", "67.5", "68.4", "72", "76.5", "81", "85.5", "90", "94.5", "99", "103.5", "108", "112.5", "117", "121.5", "126", "130.5", "135", "139.5", "144", "148.5", "153", "157.5", "162", "166.5", "171", "175.5", "180", "270", "360", "450", "540", "630", "720", "810", "900"])

show_peak      = input.bool(true, "Tepe Filtresini Göster / Show Peak Filter", group=GRP_VIS)
show_valley    = input.bool(true, "Dip Filtresini Göster / Show Valley Filter", group=GRP_VIS)
vis_style      = input.string("Basamaklı (Stepline)", "Çizgi Görsel Stili / Visual Style", options=["Basamaklı (Stepline)", "Diagonal (Eğik)"], group=GRP_VIS)
peak_color     = input.color(color.red, "Tepe Rengi / Peak Color", group=GRP_VIS)
valley_color   = input.color(color.green, "Dip Rengi / Valley Color", group=GRP_VIS)
filt_width     = input.int(2, "Çizgi Kalınlığı / Line Width", minval=1, maxval=5, group=GRP_VIS)

show_table     = input.bool(true, "Bilgi Tablosunu Göster / Show Info Table", group=GRP_TAB)
table_pos      = input.string("Top Right", "Tablo Konumu / Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=GRP_TAB)

// --- YARDIMCI FONKSİYONLAR / HELPERS ---
f_kama_atr_step(series float src, float n, float prev_kama) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.ceil(n_eff))
    float vol = 0.0
    for i = 0 to n_i - 1
        float w = (i + 1) <= n_eff ? 1.0 : (n_eff - i)
        vol += math.abs(src[i] - nz(src[i+1], src[i])) * w
    int f_n = int(math.floor(n_eff))
    int c_n = int(math.ceil(n_eff))
    float frac = n_eff - f_n
    float val_n = f_n == c_n ? nz(src[f_n], src) : nz(src[f_n], src) * (1.0 - frac) + nz(src[c_n], src) * frac
    float dir = math.abs(src - val_n)
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    float kama = na(prev_kama) ? src : prev_kama + sc * (src - prev_kama)
    [kama, n < 1.0 ? kama * n : kama]

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

// --- HESAPLAMA AKIŞI / CALCULATION FLOW ---
float tr = ta.tr(true)

// 1. Fundamental Constants & State
var float[] atr_values = array.from(0.09, 0.18, 0.225, 0.27, 0.36, 0.45, 0.54, 0.63, 0.72, 0.81, 0.9, 1.0, 1.125, 1.35, 1.8, 2.0, 2.25, 2.7, 3.15, 3.6, 4.05, 4.5, 4.95, 5.4, 5.85, 6.3, 6.75, 7.2, 7.65, 8.1, 8.55, 9.0, 9.45, 9.9, 10.35, 10.8, 11.25, 11.7, 12.15, 12.6, 13.05, 13.5, 13.95, 14.4, 14.85, 15.3, 15.75, 16.2, 16.65, 17.1, 17.55, 18.0, 20.25, 20.7, 21.6, 22.05, 22.5, 22.95, 23.4, 23.85, 24.3, 24.75, 25.2, 25.65, 26.1, 26.55, 27.0, 27.45, 27.9, 28.35, 28.8, 29.25, 29.7, 30.15, 30.6, 31.05, 31.5, 31.95, 32.4, 32.85, 33.3, 33.75, 34.2, 34.65, 35.1, 35.55, 36.0, 39.6, 40.5, 43.2, 45.0, 46.8, 49.5, 50.4, 54.0, 57.6, 58.5, 61.2, 63.0, 64.8, 67.5, 68.4, 72.0, 76.5, 81.0, 85.5, 90.0, 94.5, 99.0, 103.5, 108.0, 112.5, 117.0, 121.5, 126.0, 130.5, 135.0, 139.5, 144.0, 148.5, 153.0, 157.5, 162.0, 166.5, 171.0, 175.5, 180.0, 270.0, 360.0, 450.0, 540.0, 630.0, 720.0, 810.0, 900.0)

max_bars_back(tr, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)

// 2. Manual Selections
float p_atr_val_manual = nz(str.tonumber(p_atr_opt), 9.0)
float v_atr_val_manual = nz(str.tonumber(v_atr_opt), 9.0)

// 3. Anchor & Lookback State
int lb_input = lb_mode == "Global (Maksimum)" ? 4990 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 150 : auto_lookback
int eff_lb = math.min(math.max(1, lb_input), bar_index + 1)

f_dyn_hb(src, len) => ta.highestbars(src, math.min(len, bar_index + 1))
f_dyn_lb(src, len) => ta.lowestbars(src, math.min(len, bar_index + 1))

hb_4990 = f_dyn_hb(high, 4990), lb_4990 = f_dyn_lb(low, 4990)
hb_1500 = f_dyn_hb(high, 1500), lb_1500 = f_dyn_lb(low, 1500)
hb_auto = f_dyn_hb(high, lb_input), lb_auto = f_dyn_lb(low, lb_input)

int hb_raw = lb_mode == "Global (Maksimum)" ? hb_4990 : lb_mode == "Otomatik (Hassasiyet)" ? hb_1500 : hb_auto
int lb_raw = lb_mode == "Global (Maksimum)" ? lb_4990 : lb_mode == "Otomatik (Hassasiyet)" ? lb_1500 : lb_auto

int motor_p_idx = bar_index + hb_raw
int motor_v_idx = bar_index + lb_raw

// Persistent Parameters
var float p_atr_main = na
var float v_atr_main = na

// 4. AUTO MOTOR (SABİT GAMMA 9.0)
var int motor_p_idx_fixed = na
var int motor_v_idx_fixed = na

if lb_mode == "Zaman (Manuel Çapa)"
    if time <= p_anchor_time
        motor_p_idx_fixed := bar_index
    if time <= v_anchor_time
        motor_v_idx_fixed := bar_index

if barstate.islast and use_auto_motor
    // Peak Motor
    int start_idx_p = lb_mode == "Zaman (Manuel Çapa)" ? motor_p_idx_fixed : motor_p_idx
    float st_p = high[bar_index - start_idx_p]
    int p_start_j = math.max(start_idx_p, bar_index - 2000)
    for i = 0 to array.size(atr_values) - 1
        float val = array.get(atr_values, i)
        float cur_f = na, bool failed = false
        float cur_kama = na
        for j = p_start_j to bar_index
            off = bar_index - j
            [nk, res_atr] = f_kama_atr_step(tr[off], val, cur_kama)
            cur_kama := nk
            r = res_atr * 9.0
            if j == p_start_j
                cur_f := st_p
            else
                if high[off] - r > cur_f
                    cur_f := high[off] - r
                if low[off] + r < cur_f
                    cur_f := low[off] + r
            if close[off] > cur_f
                failed := true, break
        if not failed
            p_atr_main := val
            break
    
    // Valley Motor
    int start_idx_v = lb_mode == "Zaman (Manuel Çapa)" ? motor_v_idx_fixed : motor_v_idx
    float st_v = low[bar_index - start_idx_v]
    int v_start_j = math.max(start_idx_v, bar_index - 2000)
    for i = 0 to array.size(atr_values) - 1
        float val = array.get(atr_values, i)
        float cur_f = na, bool failed = false
        float cur_kama = na
        for j = v_start_j to bar_index
            off = bar_index - j
            [nk, res_atr] = f_kama_atr_step(tr[off], val, cur_kama)
            cur_kama := nk
            r = res_atr * 9.0
            if j == v_start_j
                cur_f := st_v
            else
                if high[off] - r > cur_f
                    cur_f := high[off] - r
                if low[off] + r < cur_f
                    cur_f := low[off] + r
            if close[off] < cur_f
                failed := true, break
        if not failed
            v_atr_main := val
            break

// 5. Final Effective Values & Sizes
float p_atr_eff = use_auto_motor ? nz(p_atr_main, p_atr_val_manual) : p_atr_val_manual
float v_atr_eff = use_auto_motor ? nz(v_atr_main, v_atr_val_manual) : v_atr_val_manual

var float p_kama_state = na
[pk, p_res_atr] = f_kama_atr_step(tr, p_atr_eff, p_kama_state)
p_kama_state := pk
float cur_p_sz = p_res_atr * 9.0

var float v_kama_state = na
[vk, v_res_atr] = f_kama_atr_step(tr, v_atr_eff, v_kama_state)
v_kama_state := vk
float cur_v_sz = v_res_atr * 9.0

// 6. Anchor Settling & History
var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p = na
var float last_f_v = na

f_get_settled_idx(bool is_peak, int lb_mode_idx, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, float c_src, int hb_49, int lb_49, int hb_15, int lb_15, int hb_a, int lb_a) =>
    int off = lb_mode_idx == 0 ? (is_peak ? hb_49 : lb_49) : lb_mode_idx == 1 ? (is_peak ? hb_15 : lb_15) : (is_peak ? hb_a : lb_a)
    int raw_ext_idx = bar_index + off
    int res_idx = prev_settled
    if na(prev_settled) or (bar_index - prev_settled > lb_val)
        res_idx := raw_ext_idx
    else
        float dist_pct = not na(prev_f) ? math.abs(c_src - prev_f) / prev_f * 100 : na
        bool prox_reset = not na(dist_pct) and dist_pct <= auto_prox_threshold
        bool threshold_reset = not na(prev_f) and not na(sz_val) and math.abs(c_src - prev_f) > auto_threshold * sz_val
        if prox_reset or threshold_reset
            res_idx := raw_ext_idx
    res_idx

int lb_mode_idx = lb_mode == "Global (Maksimum)" ? 0 : lb_mode == "Otomatik (Hassasiyet)" ? 1 : 2
settled_p_idx := lb_mode == "Zaman (Manuel Çapa)" ? na : f_get_settled_idx(true, lb_mode_idx, lb_input, last_f_p, cur_p_sz, settled_p_idx, high, low, close, hb_4990, lb_4990, hb_1500, lb_1500, hb_auto, lb_auto)
settled_v_idx := lb_mode == "Zaman (Manuel Çapa)" ? na : f_get_settled_idx(false, lb_mode_idx, lb_input, last_f_v, cur_v_sz, settled_v_idx, high, low, close, hb_4990, lb_4990, hb_1500, lb_1500, hb_auto, lb_auto)

if lb_mode == "Zaman (Manuel Çapa)"
    var int p_time_idx = na
    var int v_time_idx = na
    if time <= p_anchor_time
        p_time_idx := bar_index
    if time <= v_anchor_time
        v_time_idx := bar_index
    settled_p_idx := p_time_idx
    settled_v_idx := v_time_idx

// 7. Filter States
var FiltState fs_p = FiltState.new()
var FiltState fs_v = FiltState.new()

is_p_anc = (bar_index == settled_p_idx) or (ta.change(settled_p_idx) != 0)
is_v_anc = (bar_index == settled_v_idx) or (ta.change(settled_v_idx) != 0)
float init_p_val = high[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
float init_v_val = low[math.max(0, bar_index - nz(settled_v_idx, bar_index))]

last_f_p := fs_p.upd_filt(high, low, cur_p_sz, init_p_val, is_p_anc)
last_f_v := fs_v.upd_filt(high, low, cur_v_sz, init_v_val, is_v_anc)

// Visualization
var polyline[] p_pl = array.new<polyline>(0)
var polyline[] v_pl = array.new<polyline>(0)

if barstate.islast
    for pl in p_pl
        polyline.delete(pl)
    for pl in v_pl
        polyline.delete(pl)
    array.clear(p_pl), array.clear(v_pl)
    
    int p_idx_u = settled_p_idx
    int v_idx_u = settled_v_idx

    if show_peak and not na(p_idx_u)
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        float cur_kama = na
        int s_idx = math.max(bar_index - 4990, p_idx_u)
        float st = high[bar_index-s_idx]
        bool is_step = vis_style == "Basamaklı (Stepline)"
        for j = s_idx to bar_index
            off = bar_index - j
            [nk, res_atr] = f_kama_atr_step(tr[off], p_atr_eff, cur_kama)
            cur_kama := nk
            cf := f_r.upd_filt(high[off], low[off], res_atr * 9.0, st, j == s_idx)
            if is_step and not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(p_pl, polyline.new(pts, line_color=peak_color, line_width=filt_width))

    if show_valley and not na(v_idx_u)
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        float cur_kama = na
        int s_idx = math.max(bar_index - 4990, v_idx_u)
        float st = low[bar_index-s_idx]
        bool is_step = vis_style == "Basamaklı (Stepline)"
        for j = s_idx to bar_index
            off = bar_index - j
            [nk, res_atr] = f_kama_atr_step(tr[off], v_atr_eff, cur_kama)
            cur_kama := nk
            cf := f_r.upd_filt(high[off], low[off], res_atr * 9.0, st, j == s_idx)
            if is_step and not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(v_pl, polyline.new(pts, line_color=valley_color, line_width=filt_width))

// Table
if show_table and barstate.islast
    pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    var table info_tab = table.new(pos, 2, 3, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    c_bg = color.new(color.gray, 80), c_txt = color.white
    table.cell(info_tab, 0, 0, "💎 Volcanic v6.6", bgcolor=color.new(color.black, 40), text_color=color.yellow)
    table.cell(info_tab, 1, 0, "", bgcolor=color.new(color.black, 40))
    table.cell(info_tab, 0, 1, "Parametre", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 1, 1, "Değer", bgcolor=c_bg, text_color=c_txt)
    
    p_label = use_auto_motor ? "🤖 " : "Man: "
    v_label = use_auto_motor ? "🤖 " : "Man: "

    table.cell(info_tab, 0, 2, "Tepe ATR (G:9)", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 2, p_label + str.tostring(p_atr_eff, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
    
    table.cell(info_tab, 0, 3, "Dip ATR (G:9)", bgcolor=color.new(color.gray, 90), text_color=c_txt)
    table.cell(info_tab, 1, 3, v_label + str.tostring(v_atr_eff, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)

var label lp = na
var label lv = na
int p_idx_label = settled_p_idx
int v_idx_label = settled_v_idx
if not na(p_idx_label)
    if na(lp)
        lp := label.new(p_idx_label, high[bar_index - p_idx_label], "⚓ Tepe", color=peak_color, textcolor=color.white, style=label.style_label_down)
    else
        label.set_xy(lp, p_idx_label, high[bar_index - p_idx_label])
if not na(v_idx_label)
    if na(lv)
        lv := label.new(v_idx_label, low[bar_index - v_idx_label], "⚓ Dip", color=valley_color, textcolor=color.white, style=label.style_label_up)
    else
        label.set_xy(lv, v_idx_label, low[bar_index - v_idx_label])


alertcondition(settled_p_idx != settled_p_idx[1], "Yeni Tepe", "Otomatik çapa yeni bir tepe noktasına sabitlendi!")
alertcondition(settled_v_idx != settled_v_idx[1], "Yeni Dip", "Otomatik çapa yeni bir dip noktasına sabitlendi!")
